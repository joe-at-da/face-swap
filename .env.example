# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parliament_clips

# Redis (for Celery and caching)
REDIS_URL=redis://localhost:6379/0

# AWS (for video storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-2
S3_BUCKET=parliament-clips-dev

# Social Media (for sharing)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# Parliament TV
PARLIAMENT_TV_API_KEY=your_parliament_tv_key

# Security
SECRET_KEY=development_secret_key_change_in_production
ALGORITHM=HS256
# 24 hours token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API key for external integrations like Supabase
INTEGRATION_API_KEY=8448700525

# Development Settings
DEBUG=true
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
