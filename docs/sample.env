# Sample environment file with Supabase integration settings
# Copy this file to .env and update with your actual values

# Base settings
PROJECT_NAME="Parliament Video Clip Manager"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="info"

# Authentication
SECRET_KEY="your-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/parliament_tv"
TEST_DATABASE_URL="postgresql://postgres:postgres@db:5432/test_parliament_tv"

# Parliament TV
# Use actual Parliament TV URL - not test streams
PARLIAMENT_TV_URL=""
PARLIAMENT_TV_API_KEY=""

# Storage paths
TEMP_STORAGE_PATH="/app/data/temp"
MEDIA_STORAGE_PATH="/app/data/media"
MAX_CLIP_DURATION_MINUTES=30
CLEANUP_AGE_HOURS=24

# Storage limits
MAX_STORAGE_GB=500
TEMP_STORAGE_MAX_GB=50
MEDIA_STORAGE_QUOTA=10737418240  # 10GB
TEMP_STORAGE_QUOTA=2147483648    # 2GB
ARCHIVE_RETENTION_DAYS=180
BACKUP_RETENTION_DAYS=30

# Redis
REDIS_URL="redis://redis:6379/0"

# AWS
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-2"
S3_BUCKET="parliament-tv-clips"

# Social Media
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""

# Integration
INTEGRATION_API_KEY="your-integration-api-key"

# Supabase Integration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_API_KEY="your-supabase-api-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_MEDIA_BUCKET="parliament-tv-media"
SUPABASE_EXPORT_BUCKET="parliament-tv-exports"
SUPABASE_WEBHOOK_SECRET="your-webhook-secret"
SUPABASE_INTEGRATION_ENABLED=true
