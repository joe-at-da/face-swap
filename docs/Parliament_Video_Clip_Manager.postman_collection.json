  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login and set the access token for all requests",
          "// Skip if we're already making a login request",
          "if (!pm.request.url.toString().includes('/auth/login')) {",
          "    // Check if we have a valid token",
          "    if (!pm.environment.get('access_token') || pm.environment.get('token_expiry') <= new Date().getTime()) {",
          "        console.log('No valid token found, logging in...');",
          "        ",
          "        pm.sendRequest({",
          "            url: pm.environment.get('base_url') + '/auth/login',",
          "            method: 'POST',",
          "            header: {",
          "                'Content-Type': 'application/x-www-form-urlencoded'",
          "            },",
          "            body: {",
          "                mode: 'urlencoded',",
          "                urlencoded: [",
          "                    { key: 'username', value: pm.environment.get('email') },",
          "                    { key: 'password', value: pm.environment.get('password') }",
          "                ]",
          "            }",
          "        }, function (err, res) {",
          "            if (err) {",
          "                console.error('Error logging in:', err);",
          "            } else if (res.code === 200) {",
          "                const responseJson = res.json();",
          "                if (responseJson && responseJson.access_token) {",
          "                    console.log('Login successful, setting access token');",
          "                    pm.environment.set('access_token', responseJson.access_token);",
          "                    ",
          "                    // Set token expiry to 1 hour from now",
          "                    const expiryTime = new Date().getTime() + 60 * 60 * 1000;",
          "                    pm.environment.set('token_expiry', expiryTime);",
          "                } else {",
          "                    console.error('Login response did not contain an access token');",
          "                }",
          "            } else {",
          "                console.error('Login failed with status code:', res.code);",
          "            }",
          "        });",
          "    } else {",
          "        console.log('Using existing valid token');",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Handle login response",
          "if (pm.request.url.toString().includes('/auth/login') && pm.response.code === 200) {",
          "    const responseJson = pm.response.json();",
          "    if (responseJson && responseJson.access_token) {",
          "        console.log('Login successful, setting access token');",
          "        pm.environment.set('access_token', responseJson.access_token);",
          "        ",
          "        // Set token expiry to 1 hour from now",
          "        const expiryTime = new Date().getTime() + 60 * 60 * 1000;",
          "        pm.environment.set('token_expiry', expiryTime);",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
