                                                        {
                                                                "key": "Content-Type",
                                                                "value": "application/json"
                                                        }
                                                ],
                                                "body": {
                                                        "mode": "raw",
                                                        "raw": "{\n    \"url\": \"https://parliamentlive.tv/event/index/97c409d6-cd51-4596-9921-96e0bfeb7677\",\n    \"title\": \"Test Capture\",\n    \"description\": \"Test description\",\n    \"duration\": 90\n}",
